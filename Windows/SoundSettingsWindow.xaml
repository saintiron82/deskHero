<Window x:Class="DeskWarrior.Windows.SoundSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Theme Settings" Height="620" Width="460"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Topmost="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="PreviewBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#555"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="BorderBrush" Value="#2e2e2e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#444"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#666"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#555"/>
                                <Setter Property="Foreground" Value="#00CED1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallDarkBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#666"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SoundSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="SmallChange" Value="0.05"/>
            <Setter Property="LargeChange" Value="0.1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="0.05"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#666" BorderThickness="1" CornerRadius="10" Background="#F03A3A3A">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- X Close Button -->
            <Border Background="#662222"
                    BorderBrush="#FF4444" BorderThickness="1"
                    CornerRadius="6"
                    Width="28" Height="28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-6,-6,0"
                    Cursor="Hand"
                    MouseLeftButtonDown="CloseButton_Click"
                    Panel.ZIndex="999">
                <TextBlock Text="&#x274C;" FontSize="14" Foreground="#FF8888"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Title -->
            <TextBlock Grid.Row="0" x:Name="TitleText"
                       Foreground="White" FontWeight="Bold" FontSize="15"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <!-- Theme Selector -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ThemeLabel" Grid.Column="0" Foreground="#AAA" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ThemeComboBox" Grid.Column="1"
                          Style="{StaticResource DarkComboBox}"
                          SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#444"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#666"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#555"/>
                    </ComboBox.Resources>
                </ComboBox>
                <Button x:Name="SaveThemeBtn" Grid.Column="2" Content="+"
                        Style="{StaticResource SmallDarkBtn}" Margin="4,0,0,0"
                        Click="SaveThemeButton_Click" ToolTip="Save as custom theme"/>
                <Button x:Name="DeleteThemeBtn" Grid.Column="3" Content="-"
                        Style="{StaticResource SmallDarkBtn}" Margin="4,0,0,0"
                        Click="DeleteThemeButton_Click" ToolTip="Delete custom theme"
                        IsEnabled="False"/>
            </Grid>

            <!-- Sound Types Section Header -->
            <TextBlock Grid.Row="2" x:Name="SoundTypesHeader" Foreground="#888" FontSize="11"
                       Margin="0,0,0,6"/>

            <!-- Sound Types List (scrollable) -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                <StackPanel x:Name="SoundTypesList"/>
            </ScrollViewer>

            <!-- Category Pack Section Header -->
            <TextBlock Grid.Row="4" x:Name="PackSectionHeader" Foreground="#888" FontSize="11"
                       Margin="0,4,0,6"/>

            <!-- Category Sound Pack List -->
            <StackPanel Grid.Row="5" x:Name="CategoryPackList" Margin="0,0,0,8"/>

            <!-- Close Button -->
            <Button Grid.Row="6" x:Name="CloseBtn" Content="CLOSE"
                    Click="CloseButton_RoutedClick"
                    Background="#4A5A6A" Foreground="White"
                    BorderThickness="0" Padding="10,8"
                    Cursor="Hand" FontSize="12" FontWeight="Bold"
                    VerticalAlignment="Bottom">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A6A7A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
